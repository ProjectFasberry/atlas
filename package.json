{
	"name": "fasberry-client",
	"private": true,
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"start": "pnpm --filter * start",
		"build": "pnpm --filter * build",
		"dev": "pnpm --filter * dev",
		"lint": "pnpm --filter * lint",
		"type-check": "pnpm --filter * type-check",
		"openapi": "pnpm --filter @repo/shared openapi:prod",
		"openapi:dev": "pnpm --filter @repo/shared openapi:dev",
		"openapi:prod": "pnpm --filter @repo/shared openapi:prod",
		"openapi:check": "pnpm --filter @repo/shared openapi:check",
		"circular-check": "pnpm --filter * circlular-check",
		"postinstall": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/bun": "1.2.22",
		"concurrently": "9.1.2",
		"cross-env": "10.1.0",
		"lefthook": "2.1.4"
	}
}
