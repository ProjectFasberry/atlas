{
  "name": "wiki",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "sync:wiki": "node scripts/sync-wiki.mjs",
    "db:import": "node scripts/db-import.mjs",
    "db:export": "node scripts/db-export.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "biome check --no-errors-on-unmatched .",
    "type-check": "next typegen && tsc --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./paraglide",
    "prebuild": "paraglide-js compile --project ./project.inlang --outdir ./paraglide",
    "predev": "paraglide-js compile --project ./project.inlang --outdir ./paraglide",
    "pretype-check": "paraglide-js compile --project ./project.inlang --outdir ./paraglide",
    "translate:content": "node scripts/translate-content.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@ark-ui/react": "5.36.2",
    "@reatom/core": "3.10.3",
    "@reatom/framework": "3.4.68",
    "@reatom/npm-react": "3.10.6",
    "@reatom/primitives": "3.11.0",
    "@repo/ui": "workspace:*",
    "@tabler/icons-react": "3.50.0",
    "@tiptap/extension-image": "3.10.5",
    "@tiptap/extension-table": "3.10.5",
    "@tiptap/pm": "3.10.5",
    "@tiptap/react": "3.10.5",
    "@tiptap/starter-kit": "3.10.5",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "fumadocs-core": "16.17.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "ky": "2.0.2",
    "marked": "^18.1.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.4",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.18.0",
    "@inlang/plugin-message-format": "4.5.6",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
